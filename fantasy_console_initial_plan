# editor/src/editor/tools/build_pipeline.py
import subprocess
import shutil
import os
from pathlib import Path

class BuildPipeline:
    def __init__(self, project_path: str):
        self.project_path = Path(project_path)
        self.runtime_path = Path(__file__).parent.parent.parent.parent / 'runtime'

    def build_runtime(self, target='pi'):
        """Cross-compile runtime for Pi Zero 2 W"""
        build_dir = self.runtime_path / 'build-arm'
        build_dir.mkdir(exist_ok=True)

        # CMake configure
        subprocess.run([
            'cmake',
            '-B', str(build_dir),
            '-S', str(self.runtime_path),
            '-DCMAKE_TOOLCHAIN_FILE=cmake/arm-toolchain.cmake',
            '-DRASPBERRY_PI=ON'
        ], check=True)

        # Build
        subprocess.run([
            'cmake',
            '--build', str(build_dir),
            '-j4'
        ], check=True)

        return build_dir / 'fantasy_console'

    def create_sd_image(self, output_path: str):
        """Create bootable SD card image"""
        # Create directory structure
        img_dir = Path(output_path)
        img_dir.mkdir(exist_ok=True)

        # Copy runtime
        runtime_binary = self.build_runtime()
        shutil.copy(runtime_binary, img_dir / 'fantasy_console')

        # Copy compiled scene
        scene_file = self.project_path / 'scene.fcs'
        shutil.copy(scene_file, img_dir / 'scene.fcs')

        # Create boot script
        with open(img_dir / 'start.sh', 'w') as f:
            f.write('#!/bin/bash\n')
            f.write('cd /home/pi/fantasy_console\n')
            f.write('./fantasy_console scene.fcs\n')

        print(f"SD card image created at {output_path}")
        print("Copy to SD card and boot Pi Zero 2 W")
