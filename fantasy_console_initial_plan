        for mesh in self.meshes:
            # Vertex count
            f.write(struct.pack('I', len(mesh.vertices)))
            # Index count
            f.write(struct.pack('I', len(mesh.indices)))

            # Vertices
            for v in mesh.vertices:
                f.write(struct.pack('fff', *v.position))
                f.write(struct.pack('fff', *v.normal))
                f.write(struct.pack('ff', *v.texcoord))

            # Indices
            for idx in mesh.indices:
                f.write(struct.pack('I', idx))

            # AABB
            aabb_min, aabb_max = mesh.get_aabb()
            f.write(struct.pack('fff', *aabb_min))
            f.write(struct.pack('fff', *aabb_max))

    def _write_scene(self, f):
        f.write(struct.pack('I', len(self.entities)))
