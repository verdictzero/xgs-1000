from PIL import Image
import numpy as np
from typing import List, Tuple

class PaletteQuantizer:
    def __init__(self, max_colors=512):
        self.max_colors = max_colors
        self.palette: List[Tuple[int, int, int]] = []

    def quantize_image(self, image: Image.Image) -> Tuple[Image.Image, List[Tuple[int, int, int]]]:
        """
        Quantize image to indexed color with specified palette size
        """
        # Resize if needed
        if image.width > 256 or image.height > 256:
            image = image.resize((256, 256), Image.Resampling.LANCZOS)

        # Convert to RGB
        image = image.convert('RGB')

        # Quantize using median cut
        quantized = image.quantize(colors=self.max_colors, method=Image.Quantize.MEDIANCUT)

        # Extract palette
        palette_data = quantized.getpalette()
        self.palette = [
            (palette_data[i], palette_data[i+1], palette_data[i+2])
            for i in range(0, self.max_colors * 3, 3)
        ]

        return quantized, self.palette

    def save_indexed(self, image: Image.Image, filepath: str):
        """Save as indexed PNG"""
        image.save(filepath, 'PNG')

class TextureAtlasPacker:
    def __init__(self, max_size=2048):
        self.max_size = max_size
        self.textures: List[Tuple[str, Image.Image]] = []

    def add_texture(self, name: str, image: Image.Image):
        self.textures.append((name, image))

    def pack(self) -> Tuple[Image.Image, dict]:
        """
        Simple bin packing algorithm
        Returns: (atlas_image, uv_rects)
        """
        # Sort by height (descending)
        self.textures.sort(key=lambda x: x[1].height, reverse=True)

        # Simple shelf packing
        atlas = Image.new('RGB', (self.max_size, self.max_size), (0, 0, 0))
        uv_rects = {}

        current_x = 0
        current_y = 0
        row_height = 0

        for name, tex in self.textures:
            if current_x + tex.width > self.max_size:
                # New row
                current_x = 0
                current_y += row_height
                row_height = 0

            if current_y + tex.height > self.max_size:
                print(f"Warning: Texture {name} doesn't fit in atlas")
                continue

            # Paste texture
            atlas.paste(tex, (current_x, current_y))

            # Store UV rect (normalized 0-1)
            uv_rects[name] = {
                'x': current_x / self.max_size,
                'y': current_y / self.max_size,
                'w': tex.width / self.max_size,
                'h': tex.height / self.max_size
            }

            current_x += tex.width
            row_height = max(row_height, tex.height)

        return atlas, uv_rects
