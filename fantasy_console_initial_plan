```c
// runtime/src/renderer/lod.c
#include "renderer/lod.h"
#include <math.h>

bool lod_group_create(LODGroup* group, Mesh* high, Mesh* medium, Mesh* low) {
    group->lods[0] = high;
    group->lods[1] = medium;
    group->lods[2] = low;

    group->distances[0] = 0.0f;
    group->distances[1] = 50.0f;
    group->distances[2] = 100.0f;
    group->distances[3] = 150.0f;

    return true;
}

LODLevel lod_get_level(const LODGroup* group, Vec3 object_pos, Vec3 camera_pos) {
    Vec3 delta = vec3_sub(object_pos, camera_pos);
    float distance = vec3_length(delta);

    if (distance < group->distances[1]) return LOD_HIGH;
    if (distance < group->distances[2]) return LOD_MEDIUM;
    if (distance < group->distances[3]) return LOD_LOW;
    return LOD_CULLED;
}

Mesh* lod_get_mesh(const LODGroup* group, LODLevel level) {
    if (level == LOD_CULLED) return NULL;
    return group->lods[level];
}

void lod_group_destroy(LODGroup* group) {
    // Meshes are owned externally, just clear pointers
    for (int i = 0; i < MAX_LOD_LEVELS - 1; i++) {
        group->lods[i] = NULL;
    }
}
