#include <time.h>

typedef struct {
    RenderContext render_ctx;
    Scene* scene;
    PhysicsWorld physics;
    AudioSystem audio;

    // Frame timing
    double last_time;
    double accumulator;
    int frame_count;
    double fps;
} GameEngine;

void engine_init(GameEngine* engine) {
    // Initialize subsystems
    render_context_init(&engine->render_ctx, 640, 480, true);
    engine->scene = scene_create();
    physics_world_init(&engine->physics, (Vec3){0, -9.8f, 0});
    audio_system_init(&engine->audio, 22050);

    // Load test scene
    scene_load_fcs(engine->scene, "test_scene.fcs");

    engine->last_time = (double)clock() / CLOCKS_PER_SEC;
    engine->frame_count = 0;
    engine->fps = 25.0;
}

void engine_update(GameEngine* engine, float dt) {
    // Update physics
    physics_world_step(&engine->physics, dt);

    // Update transforms
    for (size_t i = 0; i < engine->scene->entity_count; i++) {
        Entity* e = &engine->scene->entities[i];
        if (e->active) {
            transform_update_world_matrix(&e->transform);
        }
    }
}

void engine_render(GameEngine* engine) {
    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);

    // Render all entities
    for (size_t i = 0; i < engine->scene->entity_count; i++) {
        Entity* e = &engine->scene->entities[i];
        if (e->active && (e->components & COMPONENT_MESH_RENDERER)) {
            // Set transforms, draw mesh
            mesh_draw(e->mesh);
        }
    }

    render_context_swap_buffers(&engine->render_ctx);
}

void engine_run(GameEngine* engine) {
    double target_frame_time = 1.0 / engine->fps;

    while (1) {
        double current_time = (double)clock() / CLOCKS_PER_SEC;
        double dt = current_time - engine->last_time;
        engine->last_time = current_time;

        engine_update(engine, dt);
        engine_render(engine);

        engine->frame_count++;

        // Frame rate limiting
        double frame_time = ((double)clock() / CLOCKS_PER_SEC) - current_time;
        if (frame_time < target_frame_time) {
            // Sleep for remaining time
            struct timespec sleep_time;
            sleep_time.tv_sec = 0;
            sleep_time.tv_nsec = (target_frame_time - frame_time) * 1000000000;
            nanosleep(&sleep_time, NULL);
        }
    }
}

int main(int argc, char** argv) {
    GameEngine engine;
    engine_init(&engine);
    engine_run(&engine);
    return 0;
}
