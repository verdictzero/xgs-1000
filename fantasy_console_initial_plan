#ifndef MEMORY_H
#define MEMORY_H

#include <stddef.h>
#include <stdbool.h>

typedef struct MemoryPool {
    void* memory;
    size_t block_size;
    size_t block_count;
    size_t used_blocks;
    unsigned char* free_list;
} MemoryPool;

// Initialize pool with fixed block size
bool memory_pool_init(MemoryPool* pool, size_t block_size, size_t block_count);

// Allocate from pool
void* memory_pool_alloc(MemoryPool* pool);

// Free back to pool
void memory_pool_free(MemoryPool* pool, void* ptr);

// Destroy pool
void memory_pool_destroy(MemoryPool* pool);

// Get stats
size_t memory_pool_used_bytes(const MemoryPool* pool);
float memory_pool_fragmentation(const MemoryPool* pool);

#endif
```

```c
// runtime/src/core/memory.c
#include "core/memory.h"
#include <stdlib.h>
#include <string.h>

bool memory_pool_init(MemoryPool* pool, size_t block_size, size_t block_count) {
    // Align block size to 16 bytes for SIMD
    block_size = (block_size + 15) & ~15;

    pool->block_size = block_size;
    pool->block_count = block_count;
    pool->used_blocks = 0;

    // Allocate memory
    pool->memory = aligned_alloc(16, block_size * block_count);
    if (!pool->memory) return false;

    // Initialize free list (bitfield)
    size_t free_list_size = (block_count + 7) / 8;
    pool->free_list = calloc(free_list_size, 1);
    if (!pool->free_list) {
        free(pool->memory);
        return false;
    }

    return true;
}

