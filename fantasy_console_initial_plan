class MeshData:
    def __init__(self):
        self.vertices: List[Vertex] = []
        self.indices: List[int] = []
        self.triangle_count = 0

    def get_aabb(self):
        positions = np.array([v.position for v in self.vertices])
        return positions.min(axis=0), positions.max(axis=0)

class MeshImporter:
    @staticmethod
    def import_obj(filepath: str) -> MeshData:
        scene = pywavefront.Wavefront(filepath, collect_faces=True)

        mesh = MeshData()
        vertex_map = {}

        for name, material in scene.materials.items():
            for face in material.vertices:
                # face is [x, y, z, nx, ny, nz, u, v, ...]
                for i in range(0, len(face), 8):
                    pos = (face[i], face[i+1], face[i+2])
                    normal = (face[i+3], face[i+4], face[i+5])
                    uv = (face[i+6], face[i+7])

                    vertex = Vertex(pos, normal, uv)
                    vertex_key = (pos, normal, uv)

                    if vertex_key not in vertex_map:
                        vertex_map[vertex_key] = len(mesh.vertices)
                        mesh.vertices.append(vertex)

                    mesh.indices.append(vertex_map[vertex_key])

        mesh.triangle_count = len(mesh.indices) // 3
        return mesh

    @staticmethod
    def generate_lod(mesh: MeshData, target_reduction: float) -> MeshData:
        """
        Simple LOD generation via vertex decimation
        For production: use proper edge collapse algorithm
        """
        target_tris = int(mesh.triangle_count * target_reduction)

        # Simplified: just skip triangles (bad quality)
        # TODO: Implement proper mesh simplification
        step = max(1, mesh.triangle_count // target_tris)

        lod = MeshData()
        lod.vertices = mesh.vertices.copy()

        for i in range(0, len(mesh.indices), step * 3):
            if i + 2 < len(mesh.indices):
                lod.indices.extend(mesh.indices[i:i+3])

        lod.triangle_count = len(lod.indices) // 3
        return lod
